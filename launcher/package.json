{
  "name": "sakura-launcher",
  "version": "1.0.0",
  "description": "Anime-styled Minecraft launcher",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "author": "Sakura Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.sakura.launcher",
    "productName": "Sakura Launcher",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  }
}
