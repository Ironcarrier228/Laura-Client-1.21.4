{
  "name": "laura-launcher",
  "version": "1.0.0",
  "description": "Fabric launcher for Laura Client",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "author": "Ironcarrier and Fen",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.laura.client.launcher",
    "productName": "Laura Launcher",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/libs",
        "to": "client",
        "filter": ["laura-client-*.jar"]
      }
    ]
  }
}
